@page "/login"
@using FinanceApp.Services
@inject UserSessionService Session
@inject NavigationManager Nav

<div class="d-flex align-items-center justify-content-center vh-100 bg-light">
    <div class="card shadow-lg border-0 p-4" style="width: 100%; max-width: 400px;">
        
        <div class="text-center mb-4">
            <h3 class="fw-bold text-dark">Bentornato</h3>
            <p class="text-muted">Inserisci le tue credenziali</p>
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger text-center p-2 mb-3 small">
                <i class="bi bi-exclamation-circle me-1"></i> @_errorMessage
            </div>
        }

        <EditForm Model="@_loginModel" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />

            <div class="form-floating mb-3">
                <InputText id="username" class="form-control" placeholder="Nome Utente" @bind-Value="_loginModel.Username" />
                <label for="username">Nome Utente</label>
            </div>

            <div class="form-floating mb-4">
                <InputText type="password" id="password" class="form-control" placeholder="Password" @bind-Value="_loginModel.Password" />
                <label for="password">Password</label>
            </div>

            <button type="submit" class="btn btn-primary w-100 btn-lg fw-bold mb-3">ACCEDI</button>

            <div class="text-center small text-muted">
                Admin / 1234
            </div>
        </EditForm>
    </div>
</div>

@code {
    private LoginModel _loginModel = new();
    private string _errorMessage = "";

    private async Task HandleLogin()
    {
        _errorMessage = "";
        
        // Ora funziona sicuro perché siamo in modalità socket stabile
        bool success = await Session.LoginWithCredentialsAsync(_loginModel.Username, _loginModel.Password);

        if (success)
        {
            if (Session.CanManageFinances)
                Nav.NavigateTo("/");
            else
                Nav.NavigateTo("/grocery-list");
        }
        else
        {
            _errorMessage = "Credenziali non valide.";
        }
    }

    public class LoginModel
    {
        public string Username { get; set; } = "";
        public string Password { get; set; } = "";
    }
}